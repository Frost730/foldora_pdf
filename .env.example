# ==============================================================================
# Foldora PDF - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# Operational Limits
MAX_UPLOAD_MB=50
MAX_FILES_PER_JOB=20
MAX_PAGES_PER_JOB=200
MAX_CONCURRENT_JOBS=5
JOB_TTL_MINUTES=5
MAX_PROCESSING_SECONDS=180
CLEANUP_INTERVAL_SECONDS=60

# Ephemeral File Storage (Defaults to system temp directory if left empty)
TEMP_DIR=

# Optional AI Integration (Leave empty for built-in local extractive engine)
# Supported providers: "openai", "gemini", "ollama", "custom"
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_API_BASE=

# Security & CORS (Comma-separated list or "*" for all)
CORS_ORIGINS=["*"]
